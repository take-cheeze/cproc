export data $x = align 4 { w 32, }
export
function w $f(l %.1) {
@start.1
	%.2 =l alloc8 8
	storel %.1, %.2
@body.2
	%.3 =l loadl %.2
	%.4 =l add %.3, 8
	%.5 =w loadsh %.4
	%.6 =w extsh %.5
	%.7 =l loadl %.2
	%.8 =l add %.7, 0
	%.9 =w loadub %.8
	%.10 =w extub %.9
	%.11 =w add %.6, %.10
	ret %.11
}
