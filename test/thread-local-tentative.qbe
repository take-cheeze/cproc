thread data $a = align 8 { l 100, }
thread export data $b = align 4 { w 11, }
export
function l $f() {
@start.1
@body.2
	%.1 =l loadl thread $a
	%.2 =w loadw extern thread $b
	%.3 =l extsw %.2
	%.4 =l add %.1, %.3
	%.5 =w loadw thread $c
	%.6 =l extsw %.5
	%.7 =l add %.4, %.6
	ret %.7
}
thread data $c = align 4 { z 4 }
